@page
@model MyProject.Pages.TestConnectionModel
@{
    ViewData["Title"] = "Teste de Conexão MySQL";
}

<h1>@ViewData["Title"]</h1>

<div class="alert @(Model.IsConnected ? "alert-success" : "alert-danger")">
    <h4>@(Model.IsConnected ? "✅ Conexão bem-sucedida!" : "❌ Falha na conexão")</h4>
    <p><strong>Mensagem:</strong> @Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.ServerVersion))
    {
        <p><strong>Versão do MySQL:</strong> @Model.ServerVersion</p>
    }
</div>

<form method="post">
    <button type="submit" class="btn btn-primary">Testar Conexão</button>
</form>