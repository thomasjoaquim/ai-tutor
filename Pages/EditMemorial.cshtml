@page
@model MyProject.Pages.EditMemorialModel
@{
    ViewData["Title"] = "Edit Memorial";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header" style="background-color: #1d2d56; color: white;">
                    <h3 class="mb-0" style="font-family: 'Cinzel', serif;">
                        <i class="fas fa-edit me-2"></i>Edit Memorial
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Full Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthDate" class="form-label fw-bold">Birth Date</label>
                                <input asp-for="BirthDate" class="form-control" type="date" />
                                <span asp-validation-for="BirthDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DeathDate" class="form-label fw-bold">Death Date</label>
                                <input asp-for="DeathDate" class="form-control" type="date" />
                                <span asp-validation-for="DeathDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Biography" class="form-label fw-bold">Biography</label>
                            
                            <!-- AI Assistant Button -->
                            <div class="mb-3">
                                <button type="button" class="btn btn-success" onclick="toggleAIAssistant()">
                                    <i class="fas fa-robot me-2"></i>AI Assistant
                                </button>
                            </div>
                            
                            <!-- AI Assistant Container -->
                            <div id="aiAssistantContainer" style="display: none; background: #f8f9fa; border-radius: 10px; padding: 20px; margin-bottom: 15px;">
                                <!-- Step 1: Questions Phase -->
                                <div id="questionsPhase">
                                    <h5 style="color: #1d2d56; margin-bottom: 20px;">
                                        <i class="fas fa-clipboard-list me-2"></i>Step 1: Basic Information (5 Questions)
                                    </h5>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">1. What was their full name and nickname?</label>
                                        <input type="text" id="q1" class="form-control" placeholder="e.g., John Michael Smith, known as 'Johnny'" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">2. What were their main passions or hobbies?</label>
                                        <input type="text" id="q2" class="form-control" placeholder="e.g., Gardening, fishing, playing guitar" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">3. What was their profession or main life work?</label>
                                        <input type="text" id="q3" class="form-control" placeholder="e.g., Teacher, engineer, homemaker" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">4. What are 2-3 words that best describe their personality?</label>
                                        <input type="text" id="q4" class="form-control" placeholder="e.g., Kind, funny, generous" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">5. What is a memorable moment or achievement?</label>
                                        <textarea id="q5" class="form-control" rows="3" placeholder="e.g., Traveled to 30 countries, raised 4 children"></textarea>
                                    </div>
                                    
                                    <button type="button" class="btn btn-primary" onclick="goToStep2()" style="background-color: #eaaa10; border-color: #eaaa10;">
                                        <i class="fas fa-arrow-right me-2"></i>Next: Choose Style
                                    </button>
                                </div>
                                
                                <!-- Step 2: Style Selection -->
                                <div id="stylePhase" style="display: none;">
                                    <h5 style="color: #1d2d56; margin-bottom: 20px;">
                                        <i class="fas fa-palette me-2"></i>Step 2: Choose Biography Style
                                    </h5>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">What tone would you like?</label>
                                        <select id="tone" class="form-control">
                                            <option value="formal">Formal and Respectful</option>
                                            <option value="warm" selected>Warm and Personal</option>
                                            <option value="celebratory">Celebratory and Uplifting</option>
                                            <option value="poetic">Poetic and Reflective</option>
                                        </select>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">How long should the biography be?</label>
                                        <select id="length" class="form-control">
                                            <option value="short">Short (100-150 words)</option>
                                            <option value="medium" selected>Medium (200-300 words)</option>
                                            <option value="long">Long (400-500 words)</option>
                                        </select>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-secondary" onclick="backToStep1()">
                                            <i class="fas fa-arrow-left me-2"></i>Back
                                        </button>
                                        <button type="button" class="btn btn-success" onclick="generateBiography()">
                                            <i class="fas fa-magic me-2"></i>Generate Biography
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Step 3: Preview & Confirm -->
                                <div id="previewPhase" style="display: none;">
                                    <h5 style="color: #1d2d56; margin-bottom: 20px;">
                                        <i class="fas fa-eye me-2"></i>Step 3: Review Generated Biography
                                    </h5>
                                    
                                    <div id="generatedBiography" style="background: white; border-radius: 8px; padding: 20px; margin-bottom: 20px; border: 2px solid #eaaa10; line-height: 1.8; font-size: 16px;">
                                        <div class="text-center">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p class="mt-2">Generating your biography...</p>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-secondary" onclick="backToStep2()">
                                            <i class="fas fa-arrow-left me-2"></i>Back
                                        </button>
                                        <button type="button" class="btn btn-success" onclick="confirmBiography()">
                                            <i class="fas fa-check me-2"></i>Use This Biography
                                        </button>
                                        <button type="button" class="btn btn-warning" onclick="regenerateBiography()">
                                            <i class="fas fa-redo me-2"></i>Regenerate
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <textarea asp-for="Biography" class="form-control" rows="10"></textarea>
                            <span asp-validation-for="Biography" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" style="background-color: #eaaa10; border-color: #eaaa10;">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-page="/Dashboard/Index" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ai-assistant.js"></script>
}