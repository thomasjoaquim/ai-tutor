@page
@model MyProject.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-container { min-height: calc(100vh - 200px); padding: 2rem; background: var(--neutral-50); }
    .admin-header { background: white; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm); }
    .admin-title { font-family: var(--font-serif); color: var(--brand-navy); font-size: 1.75rem; margin-bottom: 0.25rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: white; border-radius: 0.75rem; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-sm); transition: box-shadow 0.2s; }
    .stat-card:hover { box-shadow: var(--shadow-md); }
    .stat-icon { font-size: 2rem; margin-bottom: 0.75rem; }
    .stat-number { font-size: 2rem; font-weight: bold; color: var(--brand-navy); }
    .stat-label { color: var(--neutral-500); font-size: 0.9375rem; }
    .admin-section { background: white; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm); }
    .section-title { font-family: var(--font-serif); color: var(--brand-navy); font-size: 1.25rem; margin-bottom: 1rem; }
    .section-title i { margin-right: 0.5rem; color: var(--brand-gold); }
    .table th { background: var(--neutral-50); border: none; font-weight: 600; color: var(--brand-navy); font-size: 0.875rem; }
    .table td { border-color: var(--neutral-200); vertical-align: middle; }
    .user-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--brand-gold); color: var(--brand-navy); display: inline-flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 0.5rem; }
    .user-info { display: flex; align-items: center; }
    .nav-tabs .nav-link { border: none; color: var(--neutral-500); font-weight: 600; padding: 0.75rem 1.25rem; }
    .nav-tabs .nav-link.active { background: var(--brand-gold); color: var(--brand-navy); border-radius: 0.5rem 0.5rem 0 0; }
</style>

<div class="admin-container">
    <div class="container">
        <div class="admin-header">
            <h1 class="admin-title">
                <i class="fas fa-shield-alt me-3"></i>
                Admin Dashboard
            </h1>
            <p class="text-muted mb-0">LIFE's QR Administration</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon text-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-success">
                    <i class="fas fa-heart"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalMemorials</div>
                <div class="stat-label">Total Memorials</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-warning">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalTokensUsed.ToString("N0")</div>
                <div class="stat-label">Tokens Used</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-info">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-number">@Model.Stats.ActiveUsersThisMonth</div>
                <div class="stat-label">Active This Month</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="admin-section">
            <ul class="nav nav-tabs" id="adminTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
                        <i class="fas fa-users me-2"></i>Users
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="memorials-tab" data-bs-toggle="tab" data-bs-target="#memorials" type="button">
                        <i class="fas fa-heart me-2"></i>Memorials
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tokens-tab" data-bs-toggle="tab" data-bs-target="#tokens" type="button">
                        <i class="fas fa-coins me-2"></i>Token Usage
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="adminTabsContent">
                <!-- Users Tab -->
                <div class="tab-pane fade show active" id="users" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Memorials</th>
                                    <th>Joined</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @user.FirstName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <strong>@user.FirstName @user.LastName</strong>
                                                    @if (user.IsAdmin)
                                                    {
                                                        <span class="badge bg-danger ms-2">Admin</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>
                                            <span class="badge bg-primary">@user.Memorials.Count</span>
                                        </td>
                                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Memorials Tab -->
                <div class="tab-pane fade" id="memorials" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Memorial</th>
                                    <th>Owner</th>
                                    <th>Birth Date</th>
                                    <th>Death Date</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var memorial in Model.Memorials)
                                {
                                    <tr>
                                        <td>
                                            <strong>@memorial.Name</strong>
                                        </td>
                                        <td>@memorial.User.FirstName @memorial.User.LastName</td>
                                        <td>@memorial.BirthDate.ToString("dd/MM/yyyy")</td>
                                        <td>@memorial.DeathDate.ToString("dd/MM/yyyy")</td>
                                        <td>@memorial.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Token Usage Tab -->
                <div class="tab-pane fade" id="tokens" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Tokens Used</th>
                                    <th>Usage %</th>
                                    <th>Last Reset</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usage in Model.TokenUsages)
                                {
                                    var percentage = (usage.TokensUsed / 10000.0) * 100;
                                    var progressClass = percentage > 80 ? "bg-danger" : percentage > 60 ? "bg-warning" : "bg-success";
                                    
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @usage.User.FirstName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <strong>@usage.User.FirstName @usage.User.LastName</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <strong>@usage.TokensUsed.ToString("N0")</strong> / 10,000
                                        </td>
                                        <td>
                                            <span class="badge @(percentage > 80 ? "bg-danger" : percentage > 60 ? "bg-warning" : "bg-success")">
                                                @percentage.ToString("F1")%
                                            </span>
                                        </td>
                                        <td>@usage.LastReset.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar @progressClass" style="width: @percentage%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>