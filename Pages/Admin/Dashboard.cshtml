@page
@model MyProject.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: calc(100vh - 200px);
        padding: 40px 20px;
    }
    
    .admin-header {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .admin-title {
        font-family: 'Cinzel', serif;
        color: #1d2d56;
        font-size: 2.5rem;
        margin-bottom: 10px;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
    }
    
    .stat-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }
    
    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #1d2d56;
        margin-bottom: 5px;
    }
    
    .stat-label {
        color: #666;
        font-size: 1.1rem;
    }
    
    .admin-section {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .section-title {
        font-family: 'Cinzel', serif;
        color: #1d2d56;
        font-size: 1.8rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    
    .section-title i {
        margin-right: 15px;
        color: #eaaa10;
    }
    
    .table {
        margin-bottom: 0;
    }
    
    .table th {
        background: #f8f9fa;
        border: none;
        font-weight: 600;
        color: #1d2d56;
    }
    
    .table td {
        border-color: #e9ecef;
        vertical-align: middle;
    }
    
    .badge {
        font-size: 0.8rem;
    }
    
    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(45deg, #eaaa10, #d4941a);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        margin-right: 10px;
    }
    
    .user-info {
        display: flex;
        align-items: center;
    }
    
    .progress {
        height: 8px;
        border-radius: 4px;
    }
    
    .nav-tabs .nav-link {
        border: none;
        color: #666;
        font-weight: 600;
        padding: 15px 25px;
    }
    
    .nav-tabs .nav-link.active {
        background: #eaaa10;
        color: white;
        border-radius: 10px 10px 0 0;
    }
</style>

<div class="admin-container">
    <div class="container">
        <div class="admin-header">
            <h1 class="admin-title">
                <i class="fas fa-shield-alt me-3"></i>
                Admin Dashboard
            </h1>
            <p class="text-muted mb-0">Sistema de administração - Life's QR</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon text-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalUsers</div>
                <div class="stat-label">Total Users</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-success">
                    <i class="fas fa-heart"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalMemorials</div>
                <div class="stat-label">Total Memorials</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-warning">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="stat-number">@Model.Stats.TotalTokensUsed.ToString("N0")</div>
                <div class="stat-label">Tokens Used</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-info">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-number">@Model.Stats.ActiveUsersThisMonth</div>
                <div class="stat-label">Active This Month</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="admin-section">
            <ul class="nav nav-tabs" id="adminTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
                        <i class="fas fa-users me-2"></i>Users
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="memorials-tab" data-bs-toggle="tab" data-bs-target="#memorials" type="button">
                        <i class="fas fa-heart me-2"></i>Memorials
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tokens-tab" data-bs-toggle="tab" data-bs-target="#tokens" type="button">
                        <i class="fas fa-coins me-2"></i>Token Usage
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="adminTabsContent">
                <!-- Users Tab -->
                <div class="tab-pane fade show active" id="users" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Memorials</th>
                                    <th>Joined</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @user.FirstName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <strong>@user.FirstName @user.LastName</strong>
                                                    @if (user.IsAdmin)
                                                    {
                                                        <span class="badge bg-danger ms-2">Admin</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>
                                            <span class="badge bg-primary">@user.Memorials.Count</span>
                                        </td>
                                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Memorials Tab -->
                <div class="tab-pane fade" id="memorials" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Memorial</th>
                                    <th>Owner</th>
                                    <th>Birth Date</th>
                                    <th>Death Date</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var memorial in Model.Memorials)
                                {
                                    <tr>
                                        <td>
                                            <strong>@memorial.Name</strong>
                                        </td>
                                        <td>@memorial.User.FirstName @memorial.User.LastName</td>
                                        <td>@memorial.BirthDate.ToString("dd/MM/yyyy")</td>
                                        <td>@memorial.DeathDate.ToString("dd/MM/yyyy")</td>
                                        <td>@memorial.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Token Usage Tab -->
                <div class="tab-pane fade" id="tokens" role="tabpanel">
                    <div class="table-responsive mt-3">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Tokens Used</th>
                                    <th>Usage %</th>
                                    <th>Last Reset</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usage in Model.TokenUsages)
                                {
                                    var percentage = (usage.TokensUsed / 10000.0) * 100;
                                    var progressClass = percentage > 80 ? "bg-danger" : percentage > 60 ? "bg-warning" : "bg-success";
                                    
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    @usage.User.FirstName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <strong>@usage.User.FirstName @usage.User.LastName</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <strong>@usage.TokensUsed.ToString("N0")</strong> / 10,000
                                        </td>
                                        <td>
                                            <span class="badge @(percentage > 80 ? "bg-danger" : percentage > 60 ? "bg-warning" : "bg-success")">
                                                @percentage.ToString("F1")%
                                            </span>
                                        </td>
                                        <td>@usage.LastReset.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar @progressClass" style="width: @percentage%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>