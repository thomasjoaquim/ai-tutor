@page
@model MyProject.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Your Account";
    Layout = "_Layout";
}

<style>
.strength-bar { height: 4px; background: var(--neutral-200); border-radius: 2px; margin-top: 6px; overflow: hidden; }
.strength-fill { height: 100%; transition: width 0.3s; border-radius: 2px; }
.strength-weak { background: #dc3545; width: 25%; }
.strength-fair { background: #fd7e14; width: 50%; }
.strength-good { background: #ffc107; width: 75%; }
.strength-strong { background: #28a745; width: 100%; }
</style>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 bg-gradient-auth">
    <div class="card border-0 shadow-lg rounded-4 mx-3" style="max-width: 480px; width: 100%;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="logo-circle mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">L</div>
                <h2 class="h4 text-brand-navy mb-2" style="font-family: var(--font-serif);">Create Account</h2>
                <p class="text-muted small">Join and preserve precious memories</p>
            </div>
            <form method="post" id="registerForm">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="Input.FirstName" class="form-label">First Name</label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="First name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Input.LastName" class="form-label">Last Name</label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="Last name" />
                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mt-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="Input.Email" class="form-control" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mt-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="Min 6 characters" id="password" />
                    <div class="strength-bar"><div class="strength-fill" id="strengthBar"></div></div>
                    <small class="text-muted">Strength: <span id="strengthLevel">—</span></small>
                    <span asp-validation-for="Input.Password" class="text-danger small d-block"></span>
                </div>
                <div class="mt-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary-gold w-100 mt-4 py-2">
                    <i class="fas fa-user-plus me-2"></i>Create My Account
                </button>
            </form>
            <p class="text-center mt-4 mb-0 small">
                Already have an account? <a asp-page="/Account/Login" class="text-brand-gold fw-semibold text-decoration-none">Sign in here</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('password').addEventListener('input', function() {
    var p = this.value, bar = document.getElementById('strengthBar'), level = document.getElementById('strengthLevel');
    var s = 0;
    if (p.length >= 8) s++; if (/[a-z]/.test(p)) s++; if (/[A-Z]/.test(p)) s++; if (/[0-9]/.test(p)) s++; if (/[^A-Za-z0-9]/.test(p)) s++;
    var labels = ['—','Weak','Weak','Fair','Good','Strong'];
    var classes = ['','strength-weak','strength-weak','strength-fair','strength-good','strength-strong'];
    level.textContent = labels[s];
    bar.className = 'strength-fill ' + classes[s];
});
document.getElementById('registerForm').addEventListener('submit', function(e) {
    if (document.getElementById('password').value.length < 6) { e.preventDefault(); alert('Password must be at least 6 characters.'); }
});
</script>
}
