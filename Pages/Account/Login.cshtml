@page
@model MyProject.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Welcome Back";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 bg-gradient-auth">
    <div class="card border-0 shadow-lg rounded-4 mx-3" style="max-width: 420px; width: 100%;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="logo-circle mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">L</div>
                <h2 class="h4 text-brand-navy mb-2" style="font-family: var(--font-serif);">Welcome Back</h2>
                <p class="text-muted small">Sign in to your LIFE's QR account</p>
            </div>
            <form method="post">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <div class="input-with-icon">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="Input.Email" class="form-control" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.RememberMe" class="form-check-label small">Remember me for 30 days</label>
                </div>
                <button type="submit" class="btn btn-primary-gold w-100 py-2">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>
            </form>
            <p class="text-center mt-4 mb-0 small">
                Don't have an account? <a asp-page="/Account/Register" class="text-brand-gold fw-semibold text-decoration-none">Create one here</a>
            </p>
        </div>
    </div>
</div>
