@page
@model MyProject.Pages.CreateMemorialModel
@{
    ViewData["Title"] = "Create Memorial";
}

<style>
    .memorial-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px 20px;
    }
    
    .memorial-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        min-height: 700px;
    }
    
    .memorial-left {
        background: linear-gradient(45deg, #1d2d56 0%, #2c4875 100%);
        color: white;
        padding: 60px 40px;
        flex: 0 0 400px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    
    .memorial-left::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="2" fill="%23ffffff" opacity="0.1"/><circle cx="20" cy="20" r="1" fill="%23ffffff" opacity="0.1"/><circle cx="80" cy="30" r="1.5" fill="%23ffffff" opacity="0.1"/><circle cx="30" cy="80" r="1" fill="%23ffffff" opacity="0.1"/></svg>') repeat;
        animation: float 20s infinite linear;
    }
    
    @@keyframes float {
        0% { transform: translateX(-100px) translateY(-100px); }
        100% { transform: translateX(100px) translateY(100px); }
    }
    
    .memorial-right {
        padding: 60px 40px;
        flex: 1;
        overflow-y: auto;
    }
    
    .brand-logo {
        font-family: 'Cinzel', serif;
        font-size: 2.5rem;
        font-weight: bold;
        color: #eaaa10;
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }
    
    .brand-tagline {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 30px;
        position: relative;
        z-index: 1;
    }
    
    .memorial-info {
        position: relative;
        z-index: 1;
    }
    
    .info-item {
        padding: 20px 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        display: flex;
        align-items: flex-start;
    }
    
    .info-item:last-child {
        border-bottom: none;
    }
    
    .info-icon {
        width: 50px;
        height: 50px;
        background: rgba(234, 170, 16, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 20px;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    
    .info-content h4 {
        margin: 0 0 8px 0;
        font-size: 1.1rem;
    }
    
    .info-content p {
        margin: 0;
        opacity: 0.8;
        font-size: 0.9rem;
        line-height: 1.4;
    }
    
    .form-title {
        font-family: 'Cinzel', serif;
        color: #1d2d56;
        font-size: 2.2rem;
        margin-bottom: 10px;
        text-align: center;
    }
    
    .form-subtitle {
        color: #666;
        text-align: center;
        margin-bottom: 40px;
        font-size: 1.1rem;
    }
    
    .form-section {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        border-left: 4px solid #eaaa10;
    }
    
    .section-title {
        color: #1d2d56;
        font-family: 'Cinzel', serif;
        font-size: 1.3rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    
    .section-title i {
        margin-right: 10px;
        color: #eaaa10;
    }
    
    .form-group {
        margin-bottom: 25px;
    }
    
    .form-label {
        font-weight: 600;
        color: #1d2d56;
        margin-bottom: 8px;
        display: block;
    }
    
    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 15px 20px;
        font-size: 16px;
        transition: all 0.3s ease;
        width: 100%;
    }
    
    .form-control:focus {
        border-color: #eaaa10;
        box-shadow: 0 0 0 0.2rem rgba(234, 170, 16, 0.25);
        outline: none;
    }
    
    .ai-help-section {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
    }
    
    .ai-help-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }
    
    .ai-help-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    
    .btn-ai-help {
        background: rgba(255,255,255,0.2);
        border: 2px solid rgba(255,255,255,0.3);
        color: white;
        border-radius: 25px;
        padding: 8px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-ai-help:hover {
        background: rgba(255,255,255,0.3);
        border-color: rgba(255,255,255,0.5);
        color: white;
        transform: translateY(-2px);
    }
    
    .ai-chat-container {
        display: none;
        background: rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }
    
    .chat-messages {
        height: 300px;
        overflow-y: auto;
        background: rgba(255,255,255,0.9);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        color: #333;
    }
    
    .message {
        margin-bottom: 15px;
        padding: 12px 15px;
        border-radius: 12px;
        max-width: 85%;
    }
    
    .message.ai {
        background: #e3f2fd;
        border-left: 4px solid #2196f3;
        margin-right: auto;
    }
    
    .message.user {
        background: #f1f8e9;
        border-left: 4px solid #4caf50;
        margin-left: auto;
    }
    
    .chat-input-group {
        display: flex;
        gap: 10px;
        align-items: stretch;
    }
    
    .chat-input-group input {
        flex: 1;
        background: rgba(255,255,255,0.9);
        border: none;
        border-radius: 8px;
        padding: 12px 15px;
        color: #333;
    }
    
    .chat-input-group button {
        border-radius: 8px;
        padding: 12px 20px;
        font-weight: 600;
        border: none;
    }
    
    .btn-create {
        background: linear-gradient(45deg, #eaaa10, #d4941a);
        border: none;
        border-radius: 12px;
        padding: 18px 40px;
        font-size: 18px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        margin-top: 30px;
        width: 100%;
    }
    
    .btn-create:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(234, 170, 16, 0.4);
        color: white;
    }
    
    .btn-cancel {
        background: #6c757d;
        border: none;
        border-radius: 12px;
        padding: 18px 40px;
        font-size: 18px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        margin-top: 15px;
        width: 100%;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    
    .btn-cancel:hover {
        background: #5a6268;
        transform: translateY(-2px);
        color: white;
        text-decoration: none;
    }
    
    .text-danger {
        font-size: 14px;
        margin-top: 5px;
    }
    
    .alert {
        border-radius: 12px;
        margin-bottom: 20px;
    }
    
    @@media (max-width: 992px) {
        .memorial-card {
            flex-direction: column;
            margin: 10px;
        }
        
        .memorial-left {
            flex: none;
            padding: 40px 30px;
            text-align: center;
        }
        
        .memorial-right {
            padding: 40px 30px;
        }
        
        .brand-logo {
            font-size: 2rem;
        }
        
        .form-title {
            font-size: 1.8rem;
        }
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

<div class="memorial-container">
    <div class="memorial-card">
        <!-- Left Side - Information -->
        <div class="memorial-left">
            <div>
                <h1 class="brand-logo">LIFE's QR</h1>
                <p class="brand-tagline">Creating Lasting Memories</p>
                
                <div class="memorial-info">
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="info-content">
                            <h4>Honor Their Memory</h4>
                            <p>Create a beautiful digital tribute that celebrates their life and preserves their story for future generations.</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="info-content">
                            <h4>AI-Powered Writing</h4>
                            <p>Our intelligent assistant will help you craft a meaningful biography by asking thoughtful questions about their life.</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-share-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4>Easy Sharing</h4>
                            <p>Share their story through QR codes that can be placed on headstones, memorial cards, or anywhere meaningful.</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-infinity"></i>
                        </div>
                        <div class="info-content">
                            <h4>Forever Preserved</h4>
                            <p>Their memory will be safely stored and accessible forever, ensuring their legacy lives on.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Side - Form -->
        <div class="memorial-right">
            <h2 class="form-title">Create Memorial</h2>
            <p class="form-subtitle">Honor your loved one with a beautiful digital tribute</p>
            
            <form method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="display: none;"></div>
                
                <!-- Basic Information Section -->
                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-user"></i>
                        Basic Information
                    </h3>
                    
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-signature me-2"></i>Full Name *
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter their full name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="BirthDate" class="form-label">
                                    <i class="fas fa-birthday-cake me-2"></i>Date of Birth *
                                </label>
                                <input asp-for="BirthDate" class="form-control" type="date" required />
                                <span asp-validation-for="BirthDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DeathDate" class="form-label">
                                    <i class="fas fa-cross me-2"></i>Date of Death *
                                </label>
                                <input asp-for="DeathDate" class="form-control" type="date" required />
                                <span asp-validation-for="DeathDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Biography Section -->
                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-book-open"></i>
                        Life Story
                    </h3>
                    
                    <!-- AI Help Section -->
                    <div class="ai-help-section">
                        <div class="ai-help-header">
                            <h4 class="ai-help-title">
                                <i class="fas fa-magic me-2"></i>
                                Need help writing their story?
                            </h4>
                            <button type="button" class="btn btn-ai-help" onclick="toggleAIChat()">
                                <i class="fas fa-robot me-2"></i>AI Assistant
                            </button>
                        </div>
                        <p style="margin: 0; opacity: 0.9;">Our AI will ask thoughtful questions to help you create a beautiful, meaningful biography.</p>
                        
                        <!-- Token Usage Display -->
                        <div id="tokenUsage" style="margin-top: 15px; padding: 10px; background: rgba(255,255,255,0.1); border-radius: 8px; font-size: 0.9rem;">
                            <i class="fas fa-coins me-2"></i>Loading token usage...
                        </div>
                        
                        <!-- AI Chat Container -->
                        <div id="aiChatContainer" class="ai-chat-container">
                            <div id="chatMessages" class="chat-messages">
                                <div class="message ai">
                                    <strong>AI Assistant:</strong> Hi! I'm here to help you write a beautiful biography. Let's start - what was your loved one's name and what did they like to be called?
                                </div>
                            </div>
                            <div class="chat-input-group">
                                <input type="text" id="chatInput" placeholder="Type your response here..." />
                                <button type="button" class="btn btn-primary" onclick="sendMessage()">Send</button>
                                <button type="button" class="btn btn-success" onclick="applyBiography()">Apply to Biography</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Biography" class="form-label">
                            <i class="fas fa-pen-fancy me-2"></i>Biography
                        </label>
                        <textarea asp-for="Biography" class="form-control" rows="8" 
                                  placeholder="Tell us about their life, achievements, personality, and what made them special..."></textarea>
                        <span asp-validation-for="Biography" class="text-danger"></span>
                    </div>
                </div>

                <!-- Submit Section -->
                <div class="text-center">
                    <button type="submit" class="btn btn-create">
                        <i class="fas fa-heart me-2"></i>Create Memorial
                    </button>
                    <a asp-page="/Dashboard/Index" class="btn btn-cancel">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let conversationHistory = [];

// Load token usage on page load
document.addEventListener('DOMContentLoaded', function() {
    loadTokenUsage();
    
    const chatInput = document.getElementById('chatInput');
    if (chatInput) {
        chatInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
    }
});

async function loadTokenUsage() {
    try {
        const response = await fetch('/api/chat/token-usage');
        const data = await response.json();
        
        if (response.ok) {
            const usageDiv = document.getElementById('tokenUsage');
            const percentage = ((data.monthlyLimit - data.remainingTokens) / data.monthlyLimit * 100).toFixed(1);
            usageDiv.innerHTML = `
                <i class="fas fa-coins me-2"></i>
                Tokens: ${data.remainingTokens.toLocaleString()} / ${data.monthlyLimit.toLocaleString()} remaining (${percentage}% used)
            `;
        }
    } catch (error) {
        console.error('Error loading token usage:', error);
    }
}

function toggleAIChat() {
    const container = document.getElementById('aiChatContainer');
    const isVisible = container.style.display === 'block';
    container.style.display = isVisible ? 'none' : 'block';
    
    if (!isVisible) {
        document.getElementById('chatInput').focus();
    }
}

async function sendMessage() {
    const input = document.getElementById('chatInput');
    const message = input.value.trim();
    
    if (!message) return;
    
    // Add user message
    addMessage('user', message);
    conversationHistory.push(message);
    input.value = '';
    
    // Show loading
    addMessage('ai', 'Thinking...');
    
    try {
        const response = await fetch('/api/chat/biography-assistance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                message: message,
                conversationHistory: conversationHistory.slice(0, -1)
            })
        });
        
        const data = await response.json();
        
        // Remove loading message
        const messages = document.getElementById('chatMessages');
        messages.removeChild(messages.lastChild);
        
        if (response.ok) {
            addMessage('ai', data.response);
            conversationHistory.push(data.response);
            // Refresh token usage after AI response
            loadTokenUsage();
        } else {
            addMessage('ai', data.error || 'Sorry, I encountered an error. Please try again.');
        }
    } catch (error) {
        // Remove loading message
        const messages = document.getElementById('chatMessages');
        messages.removeChild(messages.lastChild);
        addMessage('ai', 'Sorry, I\'m having trouble connecting. Please check your API key configuration.');
    }
}

function addMessage(type, content) {
    const messagesContainer = document.getElementById('chatMessages');
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${type}`;
    
    const sender = type === 'ai' ? 'AI Assistant' : 'You';
    messageDiv.innerHTML = `<strong>${sender}:</strong> ${content}`;
    
    messagesContainer.appendChild(messageDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

function applyBiography() {
    const userResponses = conversationHistory.filter((msg, index) => index % 2 === 0);
    
    if (userResponses.length > 0) {
        const biography = userResponses.join(' ');
        document.getElementById('Biography').value = biography;
        
        // Show success message
        const successDiv = document.createElement('div');
        successDiv.className = 'alert alert-success';
        successDiv.innerHTML = '<i class="fas fa-check-circle me-2"></i>Biography has been applied to the form!';
        successDiv.style.marginTop = '15px';
        
        const container = document.getElementById('aiChatContainer');
        container.appendChild(successDiv);
        
        setTimeout(() => {
            successDiv.remove();
        }, 3000);
    } else {
        alert('Please have a conversation with the AI first to generate content.');
    }
}

// Allow Enter key to send message
// (moved to DOMContentLoaded above)
</script>