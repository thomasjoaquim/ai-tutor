@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero (redesign: gradient navy, title + gold accent) -->
<section class="hero-memorial position-relative">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center text-white">
                <h1 class="mb-4" style="font-family: var(--font-serif);">
                    Preserve Memories,<br><span class="text-gold">Honor Lives</span>
                </h1>
                <p class="lead mb-4 opacity-90">
                    Create lasting digital memorials, accessible via QR Code. A modern, respectful way to celebrate those we love.
                </p>
                <div class="hero-cta">
                    <a asp-page="/Account/Register" class="btn btn-primary-gold btn-lg px-4">Create My First Memorial</a>
                    <a asp-page="/Account/Login" class="btn btn-outline-white btn-lg px-4">I Already Have an Account</a>
                </div>
            </div>
        </div>
    </div>
    <div class="position-absolute bottom-0 start-0 end-0" style="height: 100px; background: linear-gradient(to top, var(--neutral-50), transparent); pointer-events: none;"></div>
</section>

<!-- How It Works (3 steps) -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="display-6 text-brand-navy mb-3" style="font-family: var(--font-serif);">How It Works</h2>
            <p class="text-muted">Three simple steps to create an everlasting tribute</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="step-icon mx-auto mb-4"><i class="fas fa-heart fa-2x text-brand-gold"></i></div>
                <h3 class="h5 text-brand-navy mb-3" style="font-family: var(--font-serif);">1. Create the Memorial</h3>
                <p class="text-muted">Add name, dates, and a caring biography. Our AI can help you write a meaningful text if you need it.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-icon mx-auto mb-4"><i class="fas fa-qrcode fa-2x text-brand-gold"></i></div>
                <h3 class="h5 text-brand-navy mb-3" style="font-family: var(--font-serif);">2. Get Your QR Code</h3>
                <p class="text-muted">Download the generated QR Code and place it on a headstone, urn, frame, or keepsake.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-icon mx-auto mb-4"><i class="fas fa-share-alt fa-2x text-brand-gold"></i></div>
                <h3 class="h5 text-brand-navy mb-3" style="font-family: var(--font-serif);">3. Share the Story</h3>
                <p class="text-muted">Family and friends can view the memorial by scanning the code or using the permanent public link.</p>
            </div>
        </div>
    </div>
</section>

<!-- Benefits (grid 2x3) -->
<section class="py-5" style="background: var(--neutral-50);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="display-6 text-brand-navy mb-3" style="font-family: var(--font-serif);">Why LIFE's QR</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card card-memorial h-100 border-0">
                    <div class="card-body text-center p-4">
                        <div class="step-icon mx-auto mb-3"><i class="fas fa-shield-alt fa-lg text-brand-gold"></i></div>
                        <h4 class="h6 text-brand-navy mb-2">Secure & Private</h4>
                        <p class="text-muted small mb-0">Your memories are stored safely. You control who sees what.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card card-memorial h-100 border-0">
                    <div class="card-body text-center p-4">
                        <div class="step-icon mx-auto mb-3"><i class="fas fa-clock fa-lg text-brand-gold"></i></div>
                        <h4 class="h6 text-brand-navy mb-2">Lasting</h4>
                        <p class="text-muted small mb-0">Digital tributes that stay online for generations.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card card-memorial h-100 border-0">
                    <div class="card-body text-center p-4">
                        <div class="step-icon mx-auto mb-3"><i class="fas fa-mobile-alt fa-lg text-brand-gold"></i></div>
                        <h4 class="h6 text-brand-navy mb-2">Mobile-Friendly</h4>
                        <p class="text-muted small mb-0">Easy to read on any device, anywhere.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA (navy background) -->
<section class="py-5 bg-brand-navy text-white">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="display-6 mb-4" style="font-family: var(--font-serif);">Start Preserving Memories Today</h2>
                <p class="lead mb-4 opacity-90">Join families who chose a modern, lasting way to honor their loved ones.</p>
                <a asp-page="/Account/Register" class="btn btn-primary-gold btn-lg px-5">Create My Free Memorial</a>
            </div>
        </div>
    </div>
</section>
