@page
@model IndexModel
@{
    ViewData["Title"] = "Life's QR - Memorials Made To Be Shared";
}

<style>
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') no-repeat center center;
        background-size: cover;
        padding: 150px 0;
        color: white;
        text-align: center;
    }
    .hero-section h1 {
        font-family: 'Cinzel', serif;
        font-size: 3.5rem;
        margin-bottom: 20px;
    }
    .hero-section h3 {
        font-size: 1.5rem;
        margin-bottom: 40px;
    }
    .btn-gold {
        background-color: #eaaa10;
        border-color: #eaaa10;
        color: white;
        padding: 12px 30px;
        margin: 0 10px;
    }
    .btn-blue {
        background-color: #1d2d56;
        border-color: #1d2d56;
        color: white;
        padding: 12px 30px;
        margin: 0 10px;
    }
    .quote-section {
        padding: 80px 0;
        background-color: #f8f9fa;
    }
    .quote {
        font-size: 1.3rem;
        line-height: 1.8;
        font-style: italic;
        color: #192032;
        margin-bottom: 30px;
    }
    .author {
        font-weight: bold;
        font-size: 1.2rem;
        color: #000;
    }
    .features-section {
        padding: 80px 0;
    }
    .feature-step {
        text-align: center;
        margin-bottom: 40px;
    }
    .feature-step h3 {
        color: #1d2d56;
        margin-bottom: 20px;
    }
    .feature-step img {
        width: 100%;
        max-width: 300px;
        margin-bottom: 20px;
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Cinzel&display=swap" rel="stylesheet" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>LIFE's QR</h1>
                <h3>A digital celebration of life</h3>
                <div class="action">
                    <a href="#" class="btn btn-gold btn-lg">Search Memorials</a>
                    <a href="#" class="btn btn-blue btn-lg">View Products</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quote Section -->
<div class="quote-section">
    <div class="container">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <p class="quote">
                    "The greatest gift we can give those we've lost is to ensure their story is told - forever cherished, 
                    never forgotten. Through Life's QR, we can celebrate their life and legacy, keeping their spirit alive for 
                    generations to come."
                </p>
                <p class="author text-center">- Matt Fraser</p>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2>Bring Their Story To Life</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 feature-step">
                <h3>Step 1: Purchase your memorial</h3>
                <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Memorial package" class="img-fluid" />
                <p>Select the QR Sign of your liking — plaque or heart — and we'll carefully package your high-quality stainless steel sign and ship it to you.</p>
            </div>
            <div class="col-md-4 feature-step">
                <h3>Step 2: Create your online tribute</h3>
                <img src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Mobile phone" class="img-fluid" />
                <p>Scan the QR code and follow the simple, user-friendly wizard to set up your memorial page. Add a biography, photos, videos, a family tree, and more.</p>
            </div>
            <div class="col-md-4 feature-step">
                <h3>Step 3: Share your loved ones story</h3>
                <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="QR code on monument" class="img-fluid" />
                <p>Place your QR Sign at a headstone, urn, bench, or memorial tree. Visitors can scan the code to view photos, videos, stories, and leave messages.</p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 text-center">
                <a href="#" class="btn btn-gold btn-lg">View Products</a>
            </div>
        </div>
    </div>
</div>
