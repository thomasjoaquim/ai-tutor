@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="card card-memorial shadow-sm mx-auto py-5 px-4" style="max-width: 32rem;">
        <div class="step-icon mx-auto mb-3" style="background: rgba(220, 38, 38, 0.1);"><i class="fas fa-exclamation-triangle text-danger"></i></div>
        <h1 class="h3 text-brand-navy mb-2">Error</h1>
        <p class="text-muted mb-4">An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-3"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-page="/Index" class="btn btn-primary-gold">Back to Home</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-4">
            Development mode shows more details. Do not enable <strong>ASPNETCORE_ENVIRONMENT=Development</strong> in production.
        </p>
    }
</div>
