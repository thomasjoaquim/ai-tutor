@page
@model MyProject.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
.qr-modal { display: none; position: fixed; z-index: 1050; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); }
.qr-modal-content { background: white; margin: 5% auto; padding: 1.5rem; border-radius: 0.75rem; width: 90%; max-width: 500px; text-align: center; box-shadow: var(--shadow-xl); }
.qr-close { color: var(--neutral-500); float: right; font-size: 1.5rem; cursor: pointer; line-height: 1.2; }
.qr-close:hover { color: var(--neutral-900); }
.qr-image { margin: 1rem 0; max-width: 100%; }
</style>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <h1 class="h3 text-brand-navy mb-0">My Memorials</h1>
        <a asp-page="/CreateMemorial" class="btn btn-primary-gold">
            <i class="fas fa-plus me-2"></i>Create New Memorial
        </a>
    </div>

    @if (Model.Memorials.Any())
    {
        <div class="memorials-grid">
            @foreach (var memorial in Model.Memorials)
            {
                <div class="memorial-card card-memorial">
                    <div class="memorial-card-body">
                        <h3 class="memorial-name">@memorial.Name</h3>
                        <p class="memorial-dates">@memorial.BirthDate.ToString("MMM dd, yyyy") — @memorial.DeathDate.ToString("MMM dd, yyyy")</p>
                        @if (!string.IsNullOrEmpty(memorial.Biography))
                        {
                            <p class="memorial-bio">@memorial.Biography.Substring(0, Math.Min(100, memorial.Biography.Length))@(memorial.Biography.Length > 100 ? "..." : "")</p>
                        }
                        else
                        {
                            <p class="memorial-bio text-muted">No biography yet.</p>
                        }
                        <div class="memorial-actions">
                            <a href="/memorial/@memorial.UniqueId" target="_blank" class="btn-action"><i class="fas fa-eye"></i> View</a>
                            <a asp-page="/EditMemorial" asp-route-id="@memorial.Id" class="btn-action"><i class="fas fa-edit"></i> Edit</a>
                            <button type="button" onclick="showQRCode(@memorial.Id, '@memorial.Name.Replace("'", "\\'")')" class="btn-action"><i class="fas fa-qrcode"></i> QR Code</button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@memorial.Id" onsubmit="return confirm('Are you sure you want to delete this memorial?');" class="d-inline">
                                <button type="submit" class="btn-action-danger w-100"><i class="fas fa-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                    <div class="memorial-card-footer">Created @memorial.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card card-memorial text-center py-5 px-4" style="max-width: 28rem; margin: 0 auto;">
            <div class="step-icon mx-auto mb-3"><i class="fas fa-heart"></i></div>
            <h3 class="text-brand-navy mb-2">No Memorials Yet</h3>
            <p class="text-muted mb-4">Create your first memorial to honor your loved ones.</p>
            <a asp-page="/CreateMemorial" class="btn btn-primary-gold">Create Your First Memorial</a>
        </div>
    }
</div>

<div id="qrModal" class="qr-modal" role="dialog" aria-labelledby="qrModalTitle" aria-modal="true">
    <div class="qr-modal-content">
        <span class="qr-close" onclick="closeQRModal()" aria-label="Close">&times;</span>
        <h3 id="qrModalTitle" class="h5 text-brand-navy mb-3">QR Code</h3>
        <img id="qrImage" class="qr-image" src="" alt="QR Code" />
        <a id="qrDownloadLink" href="" download class="btn btn-primary-gold mt-3">Download QR Code</a>
    </div>
</div>

<script>
function showQRCode(memorialId, memorialName) {
    document.getElementById('qrModal').style.display = 'block';
    document.getElementById('qrImage').src = '/api/qrcode/generate/' + memorialId;
    document.getElementById('qrDownloadLink').href = '/api/qrcode/generate/' + memorialId;
    document.getElementById('qrDownloadLink').download = 'qrcode-' + memorialName.replace(/\s+/g, '-').toLowerCase() + '.png';
    document.getElementById('qrModalTitle').textContent = 'QR Code — ' + memorialName;
}
function closeQRModal() { document.getElementById('qrModal').style.display = 'none'; }
window.onclick = function(e) { if (e.target.id === 'qrModal') closeQRModal(); };
</script>
